# Copy to automation/.env and adjust. Every setting can also be passed as a
# JOBTRACKER_-prefixed environment variable or, where it exists, a CLI flag.

# Where the Spring API lives. The worker talks to nothing else - in particular
# it never opens a database connection of its own.
JOBTRACKER_API_BASE_URL=http://localhost:8080

# Required. The API rejects every request without it. Must be the same value as
# AUTOMATION_SERVICE_KEY in the repository root .env, which is what the server
# reads. Generate a long random string; it acts across every workspace, so it is
# the one secret here that must never reach a browser.
JOBTRACKER_SERVICE_KEY=

# Seconds before a single HTTP request is abandoned.
JOBTRACKER_TIMEOUT_SECONDS=10

# Rows per page when walking the applications list.
JOBTRACKER_PAGE_SIZE=100

# nudge_stale: days of silence before an application counts as stale.
JOBTRACKER_STALE_AFTER_DAYS=14

# nudge_stale: days of silence before it is treated as ghosted. Only acted on
# with --apply; leave unset to never ghost anything automatically.
# JOBTRACKER_GHOST_AFTER_DAYS=45
