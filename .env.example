# Copy to .env and adjust.
#
# Read by two things. docker compose picks up a root .env automatically, and
# from phase 5c the API imports it as a property source - see spring.config
# .import in application.yml. Spring Boot has no special support for .env files;
# it does not need any, because a .env IS a properties file.
DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=jobtracker
DB_HOST=localhost
DB_PORT=5433

# --- Phase 5e: the role the API actually connects as ----------------------
#
# DB_USER above owns the schema and runs Flyway. The application does NOT use
# it, because PostgreSQL exempts superusers and table owners from every
# row-level security policy - connect as the owner and V8 enforces nothing.
#
# This second role owns nothing and is subject to the policies. V8 creates it
# and sets its password to whatever is here, so the two stay in step on a
# `npm run db:reset`. Change it and reset, or ALTER ROLE by hand.
DB_APP_USER=jobtracker_app
DB_APP_PASSWORD=jobtracker_app

# --- Phase 5c: Google sign-in --------------------------------------------
#
# Create these at console.cloud.google.com; docs/google-oauth-setup.md is the
# whole checklist. The app refuses to start without them, on purpose - the
# alternative is looking healthy until the first sign-in fails inside a
# redirect. The client ID is not secret; the secret is a password for your
# OAuth client and belongs only in .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phase 5c: the Python worker -----------------------------------------
#
# Shared secret the automation worker presents instead of a session cookie.
# Generate a long random value, for example:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Blank means service authentication is off and the worker gets 401s. The same
# value goes in automation/.env as JOBTRACKER_SERVICE_KEY - two names because
# each side namespaces its own configuration, one secret because it is one
# credential. It acts across every workspace, which makes it the one value here
# that must never reach a browser.
AUTOMATION_SERVICE_KEY=
