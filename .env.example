# Copy to .env and adjust.
#
# Read by docker compose, which picks up a root .env automatically. NOT read by
# the API: Spring Boot has no support for .env files, and application.yml simply
# falls back to identical defaults, which is why this looks like it works. Phase
# 5c adds spring-dotenv so the API reads this file too.
DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=jobtracker
DB_HOST=localhost
DB_PORT=5433
